{
  "expo": {
    "name": "Global Fitness",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitness-app-icon.png",
    "scheme": "globalfitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.globalfitness.training",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#0D100F",
        "foregroundImage": "./assets/images/fitness-app-foreground.png",
        "monochromeImage": "./assets/images/fitness-app-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "zh": "./assets/locales/zh.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D100F",
          "image": "./assets/images/fitness-app-foreground.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "669fb8b0-d580-4027-9ae6-aee3604b6152"
      }
    }
  }
}
